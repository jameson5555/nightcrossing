{
  "name": "nightcrossing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sanitize:themes": "node scripts/sanitize-theme-pool.js",
    "generate:monthly": "node scripts/generate-starters.js",
    "generate:monthly:no-enrich": "node scripts/generate-starters.js --skip-enrichment",
    "preflight:generation": "node scripts/preflight-generation.js",
    "analyze:generation": "node scripts/analyze-generation.js",
    "bench:layout": "node scripts/benchmark-layout.js",
    "metrics:regeneration": "node scripts/regeneration-metrics.js",
    "report:regeneration": "node scripts/regeneration-compare.js",
    "audit:difficulty": "node scripts/audit-difficulty.js",
    "audit:clues": "node scripts/audit-clues.js",
    "audit:ci": "npm run audit:difficulty && npm run audit:clues"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "crossword-generator-x": "^1.0.0",
    "crossword-layout-generator": "^0.1.1",
    "random-words": "^2.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "wordpos": "^2.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.5"
  }
}
