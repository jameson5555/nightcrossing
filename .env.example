# Copy to .env.local. IDs are public identifiers, never signing credentials.
# Each platform stays disabled until its account and settings are ready.
VITE_ANDROID_REWARDED_ADS_ENABLED=false
VITE_WEB_REWARDED_ADS_ENABLED=false
# Development always forces test ads. Keep true for internal/closed testing.
VITE_ADS_TEST_MODE=true
VITE_ADMOB_REWARDED_UNIT_ID=
VITE_H5_PUBLISHER_ID=ca-pub-6539140496743179
# Set only after completing docs/monetization-launch.md for that platform.
VITE_ANDROID_ADS_REVIEWED=false
VITE_WEB_ADS_REVIEWED=false
VITE_WEB_US_AD_SERVING_VERIFIED=false

# Optional web accounts. Firebase web configuration is public, not a secret.
# Keep disabled until Google sign-in and owner-only Firestore rules are set up.
VITE_CLOUD_SAVE_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local development only; ignored in production builds.
VITE_FIREBASE_EMULATORS=false
