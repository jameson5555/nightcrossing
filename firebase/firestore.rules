rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validSave() {
        return request.resource.data.keys().hasAll(['schemaVersion', 'payload', 'revision', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['schemaVersion', 'payload', 'revision', 'updatedAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 750000
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time;
      }
      allow get, delete: if owner();
      allow create: if owner() && validSave() && request.resource.data.revision == 1;
      allow update: if owner() && validSave()
        && request.resource.data.revision == resource.data.revision + 1;
      allow list: if false;
    }
  }
}
